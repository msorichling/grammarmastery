  "title": "Simple Present vs. Present Progressive",
  "grade": "5",
  "category": "Grundlagen & Erste Zeiten",
  "icon": "🌱",
  "accentColor": "blue",
  "description": "Unterscheide sicher zwischen regelmäßigen Gewohnheiten (Simple Present) und Handlungen, die genau jetzt passieren (Present Progressive).",
  "rules": {
    "summary": "Achte auf das Signalwort im Satz: Passiert etwas regelmäßig/immer (Simple Present) oder genau in diesem Moment (Present Progressive)?",
    "warning": "⚠️ Merksatz: 'He, she, it – das -s muss mit!' (im Simple Present) · 'am / is / are + Verb-ing' (im Present Progressive).",
    "sections": [
      {
        "title": "Simple Present (Gewohnheiten & Fakten)",
        "formula": "Grundform (Infinitiv) · bei he/she/it + -s (Verneinung: don't / doesn't + Infinitiv)",
        "signalWords": [
          "always",
          "usually",
          "often",
          "sometimes",
          "never",
          "every day",
          "on Sundays"
        ],
        "examples": [
          "I usually get up at 7 o'clock.",
          "My mum makes breakfast every morning.",
          "I don't go to school on Sundays."
        ]
      },
      {
        "title": "Present Progressive (Genau jetzt)",
        "formula": "am / is / are + Verb-ing (Verneinung: am not / isn't / aren't + Verb-ing)",
        "signalWords": [
          "now",
          "right now",
          "at the moment",
          "Look!",
          "Listen!",
          "today"
        ],
        "examples": [
          "Listen! She is singing in the kitchen.",
          "Look! The cat is playing with the milk.",
          "We aren't learning maths right now."
        ]
      }
    ]
  },

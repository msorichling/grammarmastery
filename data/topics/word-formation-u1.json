              ],
              "solutions": [
                "signature"
              ],
              "explanation": "sign → signature (Unterschrift).",
              "acceptedAnswers": [
                "signature"
              ],
              "answer": "signature"
            }
          ]
        },
        {
          "id": "s5",
          "sentence": "To our great {{0}}, the flight was cancelled ten minutes before boarding.",
          "gaps": [
            {
              "index": 0,
              "prompt": "DISAPPOINT",
              "grammarHint": "Adjektiv 'great' verlangt ein Nomen (-ment)",
              "hints": [
                "Hänge '-ment' an das Verb an."
              ],
              "solutions": [
                "disappointment"
              ],
              "explanation": "disappoint + -ment → disappointment (Enttäuschung).",
              "acceptedAnswers": [
                "disappointment"
              ],
              "answer": "disappointment"
            }
          ]
        },
        {
          "id": "s6",
          "sentence": "There is a strong {{0}} that the festival will be postponed due to the storm.",
          "gaps": [
            {
              "index": 0,
              "prompt": "POSSIBLE",
              "grammarHint": "Adjektiv 'strong' verlangt ein Nomen (-ity)",
              "hints": [
                "Aus '-ble' wird beim Nomen '-bility'."
              ],
              "solutions": [
                "possibility"
              ],
              "explanation": "possible → possibility (Möglichkeit / Wahrscheinlichkeit).",
              "acceptedAnswers": [
                "possibility"
              ],
              "answer": "possibility"
            }
          ]
        }

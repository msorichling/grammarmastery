            {
              "index": 0,
              "prompt": "FLEXIBLE",
              "grammarHint": "'a lot of' verlangt hier ein abstraktes Nomen (-ity)",
              "hints": [
                "Adjektive auf '-ble' bilden das Nomen meist auf '-bility'."
              ],
              "solutions": [
                "flexibility"
              ],
              "explanation": "flexible → flexibility (Flexibilität). Das '-le' wandelt sich zu '-ility'.",
              "acceptedAnswers": [
                "flexibility"
              ],
              "answer": "flexibility"
            }
          ]
        },

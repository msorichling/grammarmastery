{
  "id": "word-formation-u1",
  "title": "Word Formation: Unit 1 Challenge",
  "grade": "9-10",
  "icon": "🧩",
  "description": "Verwandle Wortstämme sicher in Nomen, Adjektive, Adverbien und Verben – inkl. negativer Präfixe (un-, in-, im-, il-, ir-, dis-) und Suffix-Training im Kontext.",
  "legacyStorageKey": "grammar_wf_u1_state",
  "legacyMasteredKey": "grammar_wf_u1_mastered",
  "rules": {
    "title": "Word Formation – Strategien für Wortfamilien",
    "summary": "Achte auf die Satzposition vor und nach der Lücke: Artikel/Adjektive verlangen ein Nomen (-tion, -ment, -ness, -ity), Verben verlangen oft ein Adverb (-ly), und Nomen verlangen ein Adjektiv (-ful, -less, -ous, -ive, -able). Prüfe außerdem immer den Sinnzusammenhang auf Verneinungen (un-, in-, dis-).",
    "examples": [
      "Verb → Noun: decide → decision | perform → performance | achieve → achievement",
      "Noun/Verb → Adjective: success → successful | create → creative | rely → reliable",
      "Adjective → Negative: happy → unhappy | possible → impossible | legal → illegal",
      "Adjective → Adverb:1 dramatic → dramatically | enthusiastic → enthusiastically"
    ]
  },
  "exercises": [
    {
      "id": "ex1",
      "title": "1. Nouns & Suffixes (-tion, -ment, -ance, -ness)",
      "type": "single_sentence",
      "instruction": "Bilde aus dem Wortstamm in Großbuchstaben das passende Nomen für die Lücke.",
      "items": [
        {
          "id": "s1",
          "sentence": "Her {{0}} in the school musical was absolutely unforgettable.",

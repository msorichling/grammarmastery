              "hints": [
                "Hänge das Nomen-Suffix '-ment' an das Verb an."
              ],
              "solutions": [
                "agreement"
              ],
              "explanation": "agree + -ment → agreement (Einigung / Vereinbarung).",
              "acceptedAnswers": [
                "agreement"
              ],
              "answer": "agreement"
            }
          ]
        },
        {
          "id": "s3",
          "sentence": "Moving to another country requires a lot of {{0}} and open-mindedness.",

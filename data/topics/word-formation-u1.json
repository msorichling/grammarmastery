            {
              "index": 0,
              "prompt": "PERFORM",
              "grammarHint": "Possessivpronomen 'Her' verlangt ein Nomen (-ance)",
              "hints": [
                "Gesucht ist ein Nomen mit der Endung -ance.",
                "Das Wort beginnt mit 'perfor...'."
              ],
              "solutions": [
                "performance"
              ],
              "explanation": "Aus dem Verb 'perform' wird mit dem Suffix '-ance' das Nomen 'performance' (Auftritt/Leistung).",
              "acceptedAnswers": [
                "performance"
              ],
              "answer": "performance"
            }
          ]
        },
        {
          "id": "s2",
          "sentence": "After a long discussion, the committee finally reached an {{0}}.",
